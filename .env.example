# Copy to .env (never commit .env). All values are local-development placeholders.

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_USER=iskolarhub
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=iskolarhub

# --- Spring Boot backend (read from this file in native mode; real environment variables take precedence) ---
DB_URL=jdbc:postgresql://localhost:5432/iskolarhub
DB_USER=iskolarhub
DB_PASSWORD=dev-only-change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173
